# Is file ko .env naam se copy karo aur apni asli values bharo.
# .env.example git mein jaa sakta hai (isme sirf placeholders hain).

# Database (Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# better-auth
BETTER_AUTH_SECRET=change-me-long-random-string
BETTER_AUTH_URL=http://localhost:3000

MCP_RESOURCE_URI=https://your-mcp-server/mcp

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI
GEMINI_API_KEY=
